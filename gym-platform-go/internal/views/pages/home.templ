package pages

import (
	"github.com/12sub/gym-platform/components/button"
	"github.com/12sub/gym-platform/internal/views/layouts"
)

templ Home() {
	@layouts.Base("Home") {
		<main class="mx-auto flex min-h-screen max-w-md flex-col items-center justify-center gap-4 p-6">
			<h1 class="text-2xl font-semibold tracking-tight">Gym Platform</h1>
			<p class="text-sm text-muted-foreground">Foundation is working.</p>
			@button.Button() {
				It works
			}
		</main>
	}
}
